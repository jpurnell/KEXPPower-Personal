#!/bin/sh
# pre-push
#
# Generated by development-guidelines/setup.swift. Re-run it, or
# `scripts/install-hooks.sh`, to regenerate.
#
# CI posture at install time: no quality-gate workflow found
# Hook profile: all — hooks are the only automatic gate, so they run everything
#
# Escape hatch: QG_SKIP=1 git <command>
set -eu

cd "$(git rev-parse --show-toplevel)"

if [ "${QG_SKIP:-0}" = "1" ]; then
  echo ""
  echo "⚠️  QUALITY GATE SKIPPED (QG_SKIP=1)"
  echo ""
  exit 0
fi

if ! command -v quality-gate >/dev/null 2>&1; then
  echo "pre-push: quality-gate not on PATH." >&2
  echo "  These hooks are this project's only automatic gate, so there is" >&2
  echo "  nothing downstream to catch what goes past them. Refusing rather" >&2
  echo "  than reporting a check that did not run." >&2
  echo "" >&2
  echo "  Install it, or bypass deliberately with QG_SKIP=1." >&2
  exit 1
fi

echo "pre-push: building..."
if [ -f Package.resolved ]; then
  swift build --only-use-versions-from-resolved-file 2>&1 | tail -3
else
  swift build 2>&1 | tail -3
fi

# --release-boundary enforces the release-tag invariant at full strength: it
# refuses a push when CHANGELOG.md documents a version whose vX.Y.Z tag does
# not exist. The CLI also infers it from the pushed-ref list git supplies on
# stdin; passing it explicitly keeps the behaviour identical by hand.
echo "pre-push: quality gate (all, release boundary)..."
if ! quality-gate --check all --strict --release-boundary; then
  echo "" >&2
  echo "pre-push: quality gate FAILED — not pushing." >&2
  echo "" >&2
  echo "  If the failure is release-readiness, a CHANGELOG version has no matching tag:" >&2
  echo "       git tag -a vX.Y.Z -m \"Version X.Y.Z\"" >&2
  echo "       git push origin main --follow-tags" >&2
  echo "" >&2
  exit 1
fi
