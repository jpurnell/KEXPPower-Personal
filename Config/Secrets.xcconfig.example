// Copy to Config/Secrets.xcconfig (which git ignores) and fill in the key.
// The key is the one registered for Spinner in the diagnostics hub's apps file. Without it the app builds and sends nothing.
DIAGNOSTICS_INGEST_KEY = _SnVHOsGpijnjqr7HkY2QPXzPWQnsE4iIqTtAkgER_c

// A Debug build can carry a development key instead of the one above: the hub subject <app>.dev, made on the hub with
// `diagnostics-hub-admin mint <hub.json> --development <app>` and shown once. Debug only; never in a Release configuration, because TestFlight
// and the App Store ship Release builds, and the hub refuses a development key from any channel but `development`.
// DIAGNOSTICS_INGEST_KEY[config=Debug] = <the development key>

